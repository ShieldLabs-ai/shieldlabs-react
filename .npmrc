# Development settings only: npm never includes .npmrc in the published package.
# @shieldlabs-ai/js, a peer dependency, is not on npm yet, so npm cannot install it by itself.
# legacy-peer-deps: npm ci and npm install leave peer dependencies to you.
# save-dev: `npm install --no-save <tarball>` still installs a local pack of @shieldlabs-ai/js.
# Remove this file once @shieldlabs-ai/js 1.x is published (see CONTRIBUTING.md).
legacy-peer-deps=true
save-dev=true
